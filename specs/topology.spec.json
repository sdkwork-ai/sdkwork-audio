          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.test": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-audio-standalone-gateway",
            "binary": "sdkwork-api-audio-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
