# Bootstrap profile cloud.production — replace with application-specific values.
SDKWORK_AUDIO_DEPLOYMENT_PROFILE=standalone
SDKWORK_AUDIO_ENVIRONMENT=production
SDKWORK_AUDIO_PROFILE_ID=standalone.production
SDKWORK_AUDIO_APPLICATION_PUBLIC_HTTP_URL=https://audio.sdkwork.com
