# cloud.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_audio_demo`
# and (when the base profile uses Redis) a dedicated Redis logical DB index / key prefix so no cache
# key (rate-limit, session, idempotency, ...) ever collides with another shared-redis environment.
# NOTE: demo MUST use an independent database schema `sdkwork_audio_demo` for isolation.
# NOTE: if Redis is used, demo MUST target a dedicated Redis logical DB index / distinct key prefix so it never collides with other environments on shared Redis.
SDKWORK_AUDIO_DEPLOYMENT_PROFILE=cloud
SDKWORK_AUDIO_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_AUDIO_PROFILE_ID=cloud.demo
SDKWORK_AUDIO_APPLICATION_PUBLIC_HTTP_URL=https://audio-demo.sdkwork.com
SDKWORK_AUDIO_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_AUDIO_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN


SDKWORK_CORS_ALLOWED_ORIGINS=https://audio-demo.sdkwork.com,http://audio-demo.sdkwork.com,https://audio-demo.birdcoder.com,http://audio-demo.birdcoder.com,https://audio-demo.dtupay.com,http://audio-demo.dtupay.com,https://audio-demo.noaper.com,http://audio-demo.noaper.com,https://audio-demo.sdkwork.cn,http://audio-demo.sdkwork.cn,https://audio-demo.birdcoder.cn,http://audio-demo.birdcoder.cn,https://audio-demo.dtupay.cn,http://audio-demo.dtupay.cn,https://audio-demo.noaper.cn,http://audio-demo.noaper.cn,https://audio-demo.skubc.com,http://audio-demo.skubc.com,https://audio-demo.skubc.cn,http://audio-demo.skubc.cn,https://audio-demo.zowalk.com,http://audio-demo.zowalk.com,https://audio-demo.zowalk.cn,http://audio-demo.zowalk.cn,https://audio-demo.offer86.com,http://audio-demo.offer86.com,https://audio-demo.offer86.cn,http://audio-demo.offer86.cn,https://audio-demo.86offer.com,http://audio-demo.86offer.com,https://audio-demo.86offer.cn,http://audio-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
